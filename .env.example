NODE_ENV=development
HOST=127.0.0.1
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_powerd_gpms_db
DB_USER=ai_gpms_app
DB_PASSWORD=replace-with-local-database-password

JWT_ACCESS_SECRET=
FRONTEND_ORIGIN=http://localhost:5173

# Local Redis, available on Windows through WSL2 localhost forwarding.
REDIS_URL=redis://127.0.0.1:6379/0
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=

# Optional password-reset email settings. Configure every variable together.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional one-time initial administrator bootstrap settings.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
